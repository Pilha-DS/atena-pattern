# Variáveis do `docker compose up` na raiz. Copie para `.env` e ajuste.
# Este arquivo não é usado pelo `uv run` local (esse é application/backend/.env).

APP_NAME=Atena App
ENVIRONMENT=development

# Banco do compose (serviço "db").
MYSQL_DATABASE=atena_app
MYSQL_USER=atena_app
MYSQL_PASSWORD=atena_app_dev
MYSQL_ROOT_PASSWORD=atena_app_root_dev

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-esta-chave-por-uma-aleatoria-de-48-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Origens do Flutter web, separadas por vírgula. "*" libera todas (só em dev).
CORS_ORIGINS=*

# Portas publicadas no host. Troque se já estiverem em uso.
API_PORT=8000
FRONTEND_PORT=8080
MYSQL_PORT=3306
